const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const mongoose = require('mongoose');
const cors = require('cors');

const app = express();
app.use(cors());
app.use(express.json());
app.use(express.static('public'));

const server = http.createServer(app);
const io = new Server(server, { cors: { origin: '*' } });

// Database Schemas
const userSchema = new mongoose.Schema({
  username: { type: String, unique: true },
  balance: { type: Number, default: 1000 }
});

const betSchema = new mongoose.Schema({
  userId: String,
  roundId: Number,
  selection: String,
  amount: Number,
  status: { type: String, default: 'PENDING' },
  payout: { type: Number, default: 0 }
});

const depositSchema = new mongoose.Schema({
  userId: { type: mongoose.Schema.Types.ObjectId, ref: 'User' },
  username: String,
  gateway: String,
  amount: Number,
  trxId: { type: String, unique: true },
  senderMobile: String,
  status: { type: String, enum: ['PENDING', 'APPROVED', 'REJECTED'], default: 'PENDING' },
  createdAt: { type: Date, default: Date.now }
});

const User = mongoose.model('User', userSchema);
const Bet = mongoose.model('Bet', betSchema);
const Deposit = mongoose.model('Deposit', depositSchema);

// Game Engine
let currentRoundId = Date.now();
let timeLeft = 60;

function getResultColor(number) {



  if (number === 0 || number === 5) return 'VIOLET';
  return number % 2 === 0 ? 'RED' : 'GREEN';
}

function startRoundTimer() {
  setInterval(async () => {
    timeLeft--;
    io.emit('timer_tick', { timeLeft, roundId: currentRoundId });

    if (timeLeft <= 0) {
      const winningNumber = Math.floor(Math.random() * 10);
      const winningColor = getResultColor(winningNumber);

      await processPayouts(currentRoundId, winningNumber, winningColor);

      io.emit('round_result', {
        roundId: currentRoundId,
        winningNumber,
        winningColor
      });

      currentRoundId = Date.now();
      timeLeft = 60;
    }
  }, 1000);
}

async function processPayouts(roundId, winningNumber, winningColor) {
  const roundBets = await Bet.find({ roundId, status: 'PENDING' });

  for (let bet of roundBets) {
    let multiplier = 0;
    if (bet.selection === winningColor) {
      multiplier = winningColor === 'VIOLET' ? 4.5 : 2;
    } else if (bet.selection === String(winningNumber)) {
      multiplier = 9;
    }

    if (multiplier > 0) {
      const winAmount = bet.amount * multiplier;
      bet.status = 'WON';
      bet.payout = winAmount;
      await User.findByIdAndUpdate(bet.userId, { $inc: { balance: winAmount } });
    } else {
      bet.status = 'LOST';
    }
    await bet.save();
  }
}

// WebSockets
io.on('connection', (socket) => {
  socket.emit('init_game', { timeLeft, roundId: currentRoundId });

  socket.on('place_bet', async (data) => {
    const { userId, selection, amount } = data;
    if (timeLeft <= 5) return socket.emit('bet_error', 'Betting locked!');

    const user = await User.findById(userId);
    if (!user || user.balance < amount) return socket.emit('bet_error', 'Insufficient balance!');

    user.balance -= amount;
    await user.save();

    const newBet = new Bet({ userId, roundId: currentRoundId, selection, amount });
    await newBet.save();

    socket.emit('bet_success', { newBalance: user.balance, selection, amount });
  });
});

// APIs
app.post('/api/user/register', async (req, res) => {
  const { username } = req.body;
  let user = await User.findOne({ username });
  if (!user) {
    user = new User({ username, balance: 1000 });
    await user.save();
  }
  res.json(user);
});

app.post('/api/deposit/submit', async (req, res) => {
  try {
    const { userId, username, gateway, amount, trxId, senderMobile } = req.body;
    const existing = await Deposit.findOne({ trxId });
    if (existing) return res.status(400).json({ message: "Trx ID already used!" });

    const deposit = new Deposit({ userId, username, gateway, amount, trxId, senderMobile });
    await deposit.save();
    res.json({ message: "Deposit submitted!" });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

app.get('/api/admin/dashboard', async (req, res) => {
  try {
    const totalUsers = await User.countDocuments();
    const pendingDeposits = await Deposit.find({ status: 'PENDING' });
    const totalDeposits = await Deposit.aggregate([
      { $match: { status: 'APPROVED' } },
      { $group: { _id: null, total: { $sum: '$amount' } } }
    ]);

    res.json({
      totalUsers,
      totalDepositAmount: totalDeposits[0]?.total || 0,
      pendingCount: pendingDeposits.length,
      pendingDeposits
    });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

app.post('/api/admin/approve-deposit', async (req, res) => {
  try {
    const { depositId } = req.body;
    const deposit = await Deposit.findById(depositId);
    if (!deposit || deposit.status !== 'PENDING') return res.status(400).json({ message: "Invalid deposit." });

    deposit.status = 'APPROVED';
    await deposit.save();
    await User.findByIdAndUpdate(deposit.userId, { $inc: { balance: deposit.amount } });

    res.json({ message: "Approved and credited!" });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

const PORT = process.env.PORT || 5000;
const MONGO_URI = process.env.MONGO_URI || 'mongodb://127.0.0.1:27017/club99';

mongoose.connect(MONGO_URI).then(() => {
  server.listen(PORT, () => {
    console.log(`Club99 running on port ${PORT}`);
    startRoundTimer();
  });
});
